__pycache__/
*.pyc

# The React build inputs. `web/` -- the build OUTPUT -- is committed on purpose:
# the Python server has no build step and no package manager, so `distil.cli ui`
# has to work on a machine with no node installed.
ui/node_modules/
ui/.vite/

# The Makefile's default HOME_DIR: memories, tools and cases made while
# experimenting. Deliberately not ~/.distil, so a `make` here cannot rewrite a
# real memory -- and deliberately not committed, because it is scratch.
state/
