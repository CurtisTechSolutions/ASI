# Copy to .env to customise the Docker Compose stack (docker-compose.yml).
# Every value is optional; these are the defaults.

# Host port of the API + frontend
RADIXNET_PORT=8000
# Host port of the Vite dev server (profile: dev)
RADIXNET_DEV_PORT=5173

# Training backend: auto (torch on cuda/mps, else python) | python | torch
RADIXNET_BACKEND=auto
# 1 = install torch into the image (GPU / vectorised backend); see docker-compose.gpu.yml
WITH_TORCH=0

# 1 = restore the newest checkpoint into /data/model.json when the API container starts
RADIXNET_RESUME=0

# Corpus file under ./data used by the train / evolve / autoevolve services
RADIXNET_CORPUS=sample_corpus.txt

# `train` service
EPOCHS=10
LR=0.5
BATCH=4

# `evolve` / `autoevolve` services
EVOLVE_SAMPLES=8
EVOLVE_MAX_LENGTH=40
EVOLVE_CHECKPOINT_EVERY=5

# `bench` service
BENCH_CHARS=50000

# Ollama for the /api/ollama endpoints (corpus from a prompt, adversarial review).
# Default: an Ollama running on the Docker host. With `--profile ollama` use http://ollama:11434.
OLLAMA_HOST=http://host.docker.internal:11434
RADIXNET_OLLAMA_MODEL=llama3.2
# Teacher model of the tutor (/api/tutor, `radixnet tutor`); falls back to RADIXNET_OLLAMA_MODEL
RADIXNET_TUTOR_MODEL=llama3.2
# Host port of the `ollama` profile service
OLLAMA_PORT=11434
